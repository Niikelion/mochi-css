{
    "name": "@mochi-css/storybook",
    "repository": "git@github.com:Niikelion/mochi-css.git",
    "version": "0.2.0",
    "license": "MIT",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "typesVersions": {
        "*": {
            "preset": [
                "./dist/index.d.ts"
            ],
            "preview": [
                "./dist/preview.d.ts"
            ]
        }
    },
    "files": [
        "/dist"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "import": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "require": "./dist/index.js"
            }
        },
        "./preset": {
            "import": {
                "types": "./dist/index.d.mts",
                "import": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "require": "./dist/index.js"
            }
        },
        "./preview": {
            "import": {
                "types": "./dist/preview.d.mts",
                "import": "./dist/preview.mjs"
            },
            "require": {
                "types": "./dist/preview.d.ts",
                "require": "./dist/preview.js"
            }
        }
    },
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@mochi-css/shared-config": "^2.0.0",
        "@mochi-css/test": "^2.0.0",
        "@types/node": "^24.8.1",
        "eslint": "^9.39.2",
        "typescript": "^5.9.3",
        "vite": "^6.0.0",
        "vitest": "^4.0.15"
    },
    "dependencies": {
        "@mochi-css/vite": "6.1.1"
    },
    "peerDependencies": {
        "storybook": "^8 || ^9",
        "vite": "^6 || ^7 || ^8"
    }
}
